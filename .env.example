PROXYAPI_API_KEY=your-proxyapi-key-here
# Для обратной совместимости вместо PROXYAPI_API_KEY можно использовать OPENAI_API_KEY
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=gpt-4o-mini
MODEL_TEMPERATURE=0.2
REQUEST_TIMEOUT=30
LOOKUP_LIMIT=5
MAX_TICKERS=10
MAX_SEARCH_QUERIES=10
MAX_OUTPUT_CHARS=4000
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=WARNING
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_USER_MESSAGES=false
